+            {\
+            float4 pos : SV_POSITION;\
+            float4 col : COLOR0;\
+            float2 uv  : TEXCOORD0;\
+            };\
+            sampler sampler0;\
+            Texture2D texture0;\
+            \
+            float4 main(PS_INPUT input) : SV_Target\
+            {\
+            float4 texel = texture0.Sample(sampler0, input.uv);\
+            if (texel.a > 0.5 && texel.b < 0.5)\
+            {\
+                float fill = saturate(texel.r);\
+                float outline = saturate(max(texel.g, fill));\
+                float fill_ratio = outline > 0.0001 ? fill / outline : 0.0;\
+                return float4(input.col.rgb * fill_ratio, input.col.a * outline);\
+            }\
+            return input.col * texel;\
+            }";
