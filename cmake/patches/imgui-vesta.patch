+static uint8_t ImGui_ImplFreeType_GetGlyphCoverage(const FT_Bitmap* ft_bitmap, int x, int y)
+{
+    const int pitch = ft_bitmap->pitch;
+    const uint8_t* row = pitch >= 0
+        ? ft_bitmap->buffer + y * pitch
+        : ft_bitmap->buffer + (ft_bitmap->rows - 1 - y) * -pitch;
+    switch (ft_bitmap->pixel_mode)
+    {
+    case FT_PIXEL_MODE_GRAY:
+        if (ft_bitmap->num_grays > 1 && ft_bitmap->num_grays != 256)
+            return (uint8_t)((unsigned int)row[x] * 255u / (ft_bitmap->num_grays - 1u));
+        return row[x];
+    case FT_PIXEL_MODE_MONO:
+        return (row[x >> 3] & (0x80u >> (x & 7))) ? 255u : 0u;
+    case FT_PIXEL_MODE_BGRA:
+        return row[x * 4 + 3];
+    default:
+        return 0u;
+    }
+}
