{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msvc-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64"
    },
    {
      "name": "debug",
      "displayName": "vesta Debug (console)",
      "description": "Debug build with console and diagnostics",
      "inherits": "msvc-base",
      "binaryDir": "${sourceDir}/build/debug"
    },
    {
      "name": "release",
      "displayName": "vesta Release (clean)",
      "description": "Optimized release build without the console module",
      "inherits": "msvc-base",
      "binaryDir": "${sourceDir}/build/release"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Build vesta Debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "displayName": "Build vesta Release",
      "configurePreset": "release",
      "configuration": "Release"
    }
  ]
}
